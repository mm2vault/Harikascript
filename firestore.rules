rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'mm2ultimatehub@gmail.com'; }

    match /catalog_items/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && (request.auth.uid == uid || isAdmin());
    }

    match /site_settings/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}